# Existing DoctorFresh MySQL database (read-only).
# Copy to .env.local and fill in. Leave unset to run on the bundled static data.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CONNECTION_LIMIT=3

# How long the catalogue is held in memory before re-querying (ms).
DB_CACHE_TTL_MS=60000

# Where catalogue media is served from. Local (/public/uploads) by default.
DB_UPLOADS_BASE_URL=/uploads

# Table names — these match the live dotindoc_website schema; override only if
# the backend renames something (see _audit/introspect-db.js).
# DB_TABLE_PRODUCTS=product
# DB_TABLE_CATEGORIES=category
# DB_TABLE_SUBCATEGORIES=sub_category
# DB_TABLE_ATTRIBUTES=attribute
# DB_TABLE_ATTRIBUTE_FILTERS=attribute_filter
# DB_TABLE_PRODUCT_REVIEWS=product_reviews
# DB_TABLE_BLOGS=blog
# DB_TABLE_BLOG_CATEGORIES=blog_category

# Sign-in (mobile + OTP). AUTH_SECRET signs the session cookie and MUST be set
# in production — without it sessions are refused rather than forgeable.
AUTH_SECRET=


# How many city pages per service family are prerendered (22,195 exist).
# PRERENDER_PER_FAMILY=40

# Site
NEXT_PUBLIC_SITE_INDEXABLE=false

# OTP service (shared RO Care endpoint — it generates, sends and checks the code).
OTP_TOKEN=
# OTP_SEND_URL=https://waterpurifierservicecenter.in/customer/ro_customer/roservice_sendotp.php
# OTP_VERIFY_URL=https://waterpurifierservicecenter.in/customer/ro_customer/service_otp_verify.php

# Set to true in development so contact/partner forms do not mail the team.
# FORMS_EMAIL_DISABLED=false
