# Existing DoctorFresh MySQL database (read-only).
# Copy to .env.local and fill in. Leave unset to run on the bundled static data.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CONNECTION_LIMIT=10

# How long the catalogue is held in memory before re-querying (ms).
DB_CACHE_TTL_MS=60000

# Where catalogue media is served from. Local (/public/uploads) by default.
DB_UPLOADS_BASE_URL=/uploads

# Table names — these match the live dotindoc_website schema; override only if
# the backend renames something (see _audit/introspect-db.js).
# DB_TABLE_PRODUCTS=product
# DB_TABLE_CATEGORIES=category
# DB_TABLE_SUBCATEGORIES=sub_category
# DB_TABLE_ATTRIBUTES=attribute
# DB_TABLE_ATTRIBUTE_FILTERS=attribute_filter
# DB_TABLE_PRODUCT_REVIEWS=product_reviews
# DB_TABLE_BLOGS=blog
# DB_TABLE_BLOG_CATEGORIES=blog_category

# Site
NEXT_PUBLIC_SITE_INDEXABLE=false
